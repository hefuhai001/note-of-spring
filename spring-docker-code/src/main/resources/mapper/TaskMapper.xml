<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="asia.hfh.code.mapper.TaskMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="asia.hfh.code.entity.TaskEntity">
        <id column="id" property="id"/>
        <result column="exe_name" property="exeName"/>
        <result column="language" property="language"/>
        <result column="code" property="code"/>
        <result column="args" property="args" typeHandler="asia.hfh.code.handler.StringListTypeHandler"/>
        <result column="status" property="status"/>
        <result column="result" property="result"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, exe_name, language, code, args, status, result, created_at, updated_at
    </sql>

    <select id="getTaskDetail" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from code_task where id=#{id}
    </select>

    <select id="selectTaskPage" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM code_task
        ORDER BY created_at DESC
            LIMIT #{size}
        OFFSET #{offset}
    </select>

    <select id="countTask" resultType="long">
        SELECT COUNT(*)
        FROM code_task
    </select>

</mapper>
