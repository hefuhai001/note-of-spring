@baseUrl = http://localhost:8080
@contentType = application/json

### 创建活动 - 未开始状态
POST {{baseUrl}}/api/activities
Content-Type: {{contentType}}

{
  "name": "双十一大促活动",
  "description": "年度最大优惠活动，全场五折起",
  "status": "not_started",
  "startTime": "2026-03-22T21:00:00",
  "endTime": "2026-03-23T00:00:00",
  "totalStock": 1000,
  "availableStock": 1000,
  "isActive": true
}

### 创建活动 - 进行中状态
POST {{baseUrl}}/api/activities
Content-Type: {{contentType}}

{
  "name": "限时秒杀活动",
  "description": "限时秒杀，先到先得",
  "status": "in_progress",
  "startTime": "2026-03-22T19:00:00",
  "endTime": "2026-03-22T23:59:59",
  "totalStock": 500,
  "availableStock": 350,
  "isActive": true
}

### 创建活动 - 即将开始(5分钟内)
POST {{baseUrl}}/api/activities
Content-Type: {{contentType}}

{
  "name": "新品首发活动",
  "description": "新品首发，限量抢购",
  "status": "not_started",
  "startTime": "2026-03-22T20:50:00",
  "endTime": "2026-03-23T02:00:00",
  "totalStock": 200,
  "availableStock": 200,
  "isActive": true
}

### 获取所有活动
GET {{baseUrl}}/api/activities
Content-Type: {{contentType}}

### 根据ID获取活动(从缓存)
GET {{baseUrl}}/api/activities/1
Content-Type: {{contentType}}

### 根据ID获取活动(从缓存)
GET {{baseUrl}}/api/activities/2
Content-Type: {{contentType}}

### 根据状态获取活动 - 未开始
GET {{baseUrl}}/api/activities/status/not_started
Content-Type: {{contentType}}

### 根据状态获取活动 - 进行中
GET {{baseUrl}}/api/activities/status/in_progress
Content-Type: {{contentType}}

### 根据状态获取活动 - 已结束
GET {{baseUrl}}/api/activities/status/ended
Content-Type: {{contentType}}

### 更新活动状态 - 开始活动
PUT {{baseUrl}}/api/activities/1/status?status=in_progress
Content-Type: {{contentType}}

### 更新活动状态 - 结束活动
PUT {{baseUrl}}/api/activities/1/status?status=ended
Content-Type: {{contentType}}

### 手动触发预热所有活动
POST {{baseUrl}}/api/activities/preload
Content-Type: {{contentType}}

### 预热即将开始的活动(未来30分钟内)
POST {{baseUrl}}/api/activities/preload/upcoming?minutes=30
Content-Type: {{contentType}}

### 刷新单个活动缓存
POST {{baseUrl}}/api/activities/1/refresh-cache
Content-Type: {{contentType}}

### 清除单个活动缓存
DELETE {{baseUrl}}/api/activities/1/cache
Content-Type: {{contentType}}

### 清除所有活动缓存
DELETE {{baseUrl}}/api/activities/cache
Content-Type: {{contentType}}
