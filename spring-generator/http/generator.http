
### 全部模版
GET {{baseUrl}}/api/code/templates


### 模版详情
GET {{baseUrl}}/api/code/template/bo.vm


### 全部表
GET {{baseUrl}}/api/code/database/tables


### 表详情
GET {{baseUrl}}/api/code/database/table/db_perfect/gen_table


### 生成所有模板代码
POST {{baseUrl}}/api/code/generate/all
Content-Type: application/json

{
  "className": "User",
  "packageName": "com.example",
  "entityName": "User",
  "entityNameLower": "user",
  "idType": "Long",
  "moduleName": "system",
  "businessName": "user",
  "functionName": "用户管理",
  "primaryKeyType": "Long",
  "mapperName": "UserMapper",
  "namespace": "com.example.mapper.UserMapper",
  "tableName": "t_user",
  "fields": [
    {
      "name": "id",
      "type": "Long"
    },
    {
      "name": "username",
      "type": "String"
    },
    {
      "name": "email",
      "type": "String"
    }
  ],
  "columns": [
    {
      "pk": true,
      "list": true,
      "javaField": "id",
      "javaType": "Long",
      "columnComment": "用户ID"
    },
    {
      "list": true,
      "javaField": "username",
      "javaType": "String",
      "columnComment": "用户名"
    },
    {
      "list": true,
      "javaField": "email",
      "javaType": "String",
      "columnComment": "邮箱"
    }
  ],
  "pkColumn": {
    "javaField": "id"
  },
  "table": {},
  "treeCode": "",
  "dicts": ""
}


