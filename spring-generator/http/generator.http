### mapper-xml
POST {{baseUrl}}/api/code/generate
Content-Type: application/json

{
  "templateName": "mapper-xml.vm",
  "variables": {
    "namespace": "com.example.mapper.UserMapper",
    "entityName": "User",
    "tableName": "t_user",
    "primaryKey": {
      "name": "id",
      "type": "Long",
      "isPrimaryKey": true
    },
    "fields": [
      {
        "name": "id",
        "type": "Long",
        "isPrimaryKey": true
      },
      {
        "name": "username",
        "type": "String",
        "comment": "用户名"
      },
      {
        "name": "email",
        "type": "String",
        "comment": "邮箱"
      }
    ]
  }
}


