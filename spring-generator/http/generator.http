### bo
POST {{baseUrl}}/api/code/generate
Content-Type: application/json

{
  "templateName": "entity.vm",
  "variables": {
    "packageName": "com.example.entity",
    "className": "User",
    "tableName": "t_user",
    "classComment": "用户实体类",
    "fields": [
      {
        "name": "id",
        "type": "Long",
        "isPrimaryKey": true
      },
      {
        "name": "username",
        "type": "String"
      },
      {
        "name": "email",
        "type": "String"
      }
    ]
  }
}


