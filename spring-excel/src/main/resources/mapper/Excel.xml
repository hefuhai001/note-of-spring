<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.hfh.mapper.ExcelMapper">
    <insert id="insertById">
        insert into employee
            (id, names, salary, birthday, photo)
        values (#{id}, #{names}, #{salary}, #{birthday}, #{photo})
    </insert>

    <delete id="deleteById">

    </delete>

    <select id="selectEmpAll" resultType="com.example.hfh.entity.Emp">
        select *
        from employee
    </select>

    <select id="selectById" resultType="java.lang.String">

    </select>

</mapper>
